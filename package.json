{
  "name": "ansan-explore",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "content:prepare": "node scripts/prepare-place-runtime.mjs",
    "predev": "npm run content:prepare",
    "dev": "vite",
    "prebuild": "npm run content:prepare",
    "build": "tsc -p tsconfig.json && vite build",
    "preview": "vite preview",
